{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundPush",
  "version": "0.1.0",
  "identifier": "net.soundpush.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNkFBRDMyQTgxMENFRDEKUldUUnpoQ29NcTFxZ3F2d0dwMVR0dU02RmtNRnlXd3JWTHZzUE53ZkpoRlBSRkdYR1EvbE1IZ1oK",
      "endpoints": [
        "https://github.com/FlyToRakib/soundpush/releases/download/updates/stable.json",
        "https://github.com/FlyToRakib/soundpush/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage", "dmg", "app"],
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "Use your phone as a speaker, microphone or headset for your computer",
    "license": "GPL-3.0-or-later",
    "copyright": "SoundPush contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.2"
    },
    "linux": {
      "deb": {
        "depends": ["libpulse0"]
      },
      "rpm": {
        "depends": ["pulseaudio-libs"]
      }
    }
  }
}
