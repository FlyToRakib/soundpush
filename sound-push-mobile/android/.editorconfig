# Kotlin style for the Android modules, read by ktlint (./gradlew ktlintCheck) and by IntelliJ.
root = true

[*.{kt,kts}]
# gradle.properties already says kotlin.code.style=official; this is ktlint's name for it.
ktlint_code_style = intellij_idea
indent_size = 4
indent_style = space
insert_final_newline = true
# Where this code already wraps. Compose call sites with several trailing lambdas run long.
max_line_length = 165
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composables and previews are PascalCase by convention, and JUnit names read as sentences.
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview, Test

# Vector path data: one unbreakable string per icon.
[core-ui/src/main/java/net/soundpush/ui/icons/SpIcons.kt]
max_line_length = off

# Generated by design/scripts/generate.mjs: the property names mirror the design-token names, and
# the next generation would undo any renaming.
[core-ui/src/main/java/net/soundpush/ui/theme/Tokens.kt]
ktlint_standard_property-naming = disabled

# Generated by uniffi-bindgen. Also excluded in build.gradle.kts, so ktlint never reads it.
[core-engine/src/main/java/uniffi/**.kt]
ktlint_standard = disabled
ktlint_experimental = disabled

[*.{xml,json,yml,yaml}]
indent_size = 4
indent_style = space
insert_final_newline = true
