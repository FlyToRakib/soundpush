    <!-- Battery optimisation guides per phone maker -->
    <string name="battery_intro">Android and some phone makers stop apps in the background to save battery. Make these changes so streams keep playing with the screen off.</string>
    <string name="battery_steps">Steps</string>
    <string name="battery_open_battery">Battery settings</string>
    <string name="battery_open_app">App settings</string>
    <string name="battery_open_autostart">Autostart settings</string>
    <string name="battery_learn_more">More tips for your phone (dontkillmyapp.com)</string>
    <string name="battery_xiaomi_1">Turn on Autostart for SoundPush.</string>
    <string name="battery_xiaomi_2">In Battery saver, choose “No restrictions”.</string>
    <string name="battery_xiaomi_3">Open recent apps, long-press SoundPush and tap the lock.</string>
    <string name="battery_samsung_1">Settings → Battery → Background usage limits: add SoundPush to “Never sleeping apps”.</string>
    <string name="battery_samsung_2">In SoundPush\'s app info, set Battery to “Unrestricted”.</string>
    <string name="battery_huawei_1">Settings → Battery → App launch: turn off “Manage automatically” for SoundPush and allow all three options.</string>
    <string name="battery_huawei_2">Open recent apps and lock SoundPush.</string>
    <string name="battery_oppo_1">Allow Auto launch for SoundPush.</string>
    <string name="battery_oppo_2">In SoundPush\'s battery usage, allow background activity.</string>
    <string name="battery_oneplus_1">Settings → Battery → Battery optimisation: set SoundPush to “Don\'t optimise”.</string>
    <string name="battery_oneplus_2">Open recent apps and lock SoundPush.</string>
    <string name="battery_generic_1">In SoundPush\'s app info, set Battery to “Unrestricted” (or “Don\'t optimise”).</string>

