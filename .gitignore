# OS
.DS_Store
Thumbs.db

# Rust
/target/
**/target/

# Node / desktop UI
node_modules/
dist/
.svelte-kit/
*.log
test-results/
playwright-report/

# Android
.gradle/
**/build/
local.properties
*.apk
*.aab
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
# Kotlin compiler daemon session files (sound-push-mobile/android/.kotlin/sessions).
.kotlin/
sound-push-mobile/android/core-engine/src/main/jniLibs/
# Throwaway Gradle home `just mobile-verification` downloads into; the recipe deletes it afterwards.
sound-push-mobile/android/.gradle-cold-home/

# Generated
sound-push-desktop/ui/src/lib/engine/bindings.ts
sound-push-mobile/android/core-engine/src/main/java/uniffi/

# Secrets / signing. Never commit signing material, not even zipped: see tools/ci/no-secrets.mjs,
# which fails the build if any of it appears, and docs/release-signing.md for where keys belong.
*.jks
*.keystore
*.pfx
*.p12
.env
.soundpush/
.soundpush*
*soundpush-release.*
*soundpush-updater.*

# Local tool config
.claude/

# VB-CABLE package downloaded at build time (sound-push-desktop/drivers/vbcable/fetch.sh)
sound-push-desktop/drivers/vbcable/package/
sound-push-desktop/drivers/vbcable/*.zip
# Shared debug signing key (not a secret) so every build updates an installed debug build.
!sound-push-mobile/android/debug.keystore
